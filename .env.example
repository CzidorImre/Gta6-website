# Wanted Level environment variables.
#
# Local development: run `pnpm env:local` after `pnpm supabase start`. It copies this file to
# .env.local and fills in the local Supabase URL and keys for you. Never commit .env.local.
# Production: set these in Vercel > Project > Settings > Environment Variables (see README).
# Everything is read at request time, so changing a value only needs a redeploy, not a code change.

# --- Site ---------------------------------------------------------------------------------------
# Public base URL, no trailing slash. Used in email links and calendar files.
# Production: https://wantedlevel.be
SITE_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------------------------------------
# Project URL. Local: http://127.0.0.1:54321. Production: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...). Safe to expose, but we only use it on the server.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_..., the old "service_role" key). SERVER ONLY. Bypasses row-level
# security: used for account deletion, reports, organizer applications, rate limits and looking
# up email addresses for notifications. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- MapTiler (map tiles + address search) ------------------------------------------------------
# Free tier key from https://cloud.maptiler.com/account/keys/. Restrict it to your domains in the
# MapTiler dashboard (it is visible in tile URLs). Without it the map shows pins on a blank
# background and organizers place the venue pin by hand.
MAPTILER_API_KEY=
# Optional map style id (default: dataviz-dark).
MAPTILER_STYLE=dataviz-dark

# --- Cloudflare Turnstile (bot protection) --------------------------------------------------------
# From https://dash.cloudflare.com/?to=/:account/turnstile. Used on signup, login, organizer
# applications and reports. Leave both empty locally to skip the check (a production deployment
# refuses to accept reports/applications without the secret). For testing with a real widget, use
# Cloudflare's always-pass keys: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA.
# Signup/login tokens are verified by Supabase Auth: put the same secret in the Supabase dashboard
# (Authentication > Attack Protection > Captcha, provider Turnstile).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email ----------------------------------------------------------------------------------------
# Resend API key (https://resend.com/api-keys), with wantedlevel.be verified as a sending domain.
# Without it, emails go to MAILPIT_URL (local) or are only logged.
RESEND_API_KEY=
EMAIL_FROM="Wanted Level <noreply@wantedlevel.be>"
EMAIL_REPLY_TO=hello@wantedlevel.be
# Who gets "new report / new application / event to review" emails. Comma-separated.
ADMIN_NOTIFICATION_EMAILS=
# Local only: the Mailpit inbox that `supabase start` runs. Ignored in production.
MAILPIT_URL=http://127.0.0.1:54324

# --- Rate limiting --------------------------------------------------------------------------------
# Random secret used to hash IP addresses and emails before they are counted in Postgres.
# Generate with: openssl rand -base64 32. Required in production.
RATE_LIMIT_SECRET=
